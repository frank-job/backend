<% - include('partials/header') %>

<main>
    <section class="dashboard">
    <h1 class="dashboard-title"><%= title %></h1>
    <!-- <h2>Dashboard</h2> -->
    <!-- <p>Name: <%= name %></p> -->
    <p>username: <%= email %></p>
    
    <% if (isAdmin) { %>
        <div class="admin-section">
            <h2>Admin Options</h2>
            <ul>
                <li><a href="/users">View All Users</a></li>
            </ul>
        </div>
    <% } %>
    </section>
</main>
<style>
    .admin-section a{
        margin-top: 30px;
        padding: 20px;
        background-color: rgb(14, 176, 230);
        /* background-color: #; */
        border-radius: 8px;
        box-shadow: var(--shadow);
        text-decoration: none;
        color: var(--primary);
    }
     .admin-section a:hover {
        background-color: #8abced;
    }
    .dashboard {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
          background-color: lightblue;
        /* background-color: var(--); */
        border-radius: 12px;
        box-shadow: var(--shadow);
        text-align: center;
    }
    .dashboard-title {
        color: var(--primary);
        margin-bottom: 20px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
    }
    </style>

<% - include('partials/footer') %>