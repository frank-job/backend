<%- include('partials/header') %>
    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <ul class="grid-list">
            <% organizations.forEach(organization=> { %>
                <li class="project-card">
                    <h2>
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </h2>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <p>
                        <%= organization.description %>
                    </p>
                    <a href="/organization/<%= organization.organization_id %>" class="view-details-btn">View
                        Profile</a>
                </li>
                <% }); %>
        </ul>
    </main>
    <p class="bttn"><a href="/new-organization">Add a new organization</a></p>
    <%- include('partials/footer') %>