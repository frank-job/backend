<%- include('partials/header') %>

    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <ul class="grid-list">
            <% organizations.forEach(organization=> { %>
                <li class="project-card">
                    <h2>
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </h2>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <p>
                        <%= organization.description %>

                    </p>
                    <% if (user && user.role_name === 'admin') { %>
                    <p><a href="/edit-organization/<%= organization.organization_id %>" class="btn-small">Edit Organization</a></p>
                    <% } %>
                </li>
                <% }); %> <!-- THE LOOP ENDS HERE -->
        </ul>
        <% if (user && user.role_name === 'admin') { %>
    <a href="/new-organization">Add New Organization</a>
<% } %>
        <!-- <p><a href="/new-organization" class="view-details-btn">Add a new organization</a></p> -->
       
    </main>

    <%- include('partials/footer') %> <!-- THE FOOTER MUST BE DOWN HERE, OUTSIDE THE LOOP -->

