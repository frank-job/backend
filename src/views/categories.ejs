<%- include('partials/header') %>

    <main>
        <h1>Service Categories <span>u mastered ur work in class we mastered to get connections</span></h1>
        <ul class="grid-categories">
            <% categories.forEach(category=> { %>
                <li>
                    <img src="/images/<%= category.category_image %>" alt="<%= category.category_name %> icon">

                    <strong>
                        <%= category.category_name %>
                    </strong>

                    <!-- This adds your new words -->
                    <p class="category-desc">
                        <%= category.category_description %>
                    </p>

                    <!-- Inside the EJS loop -->
                     <div class="btn-actions">
                    <a href="#" class="btn-small">View Projects</a>
                    </div>
                </li>
                <% }); %>
        </ul>
    </main>

<%- include('partials/footer') %>