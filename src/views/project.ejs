<%- include('partials/header') %>

    <main class="container-project-details">
        <section class="project-details-card">
            <h1>
                <%= project.title %>
            </h1>

            <div class="meta-info">
                <p><strong>Date:</strong>
                    <%= project.date %>
                </p>
                <p><strong>Location:</strong>
                    <%= project.location %>
                </p>
                <p><strong>Partner Organization:</strong>
                    <!-- Requirement: Link back to the organization details -->
                    <a href="/organization/<%= project.organization_id %>" class="org-link">
                        <%= project.organization_name %>
                    </a>
                </p>
            </div>

            <hr>

            <div class="project-description">
                <h2>About this Project</h2>
                <p>
                    <%= project.description %>
                </p>
            </div>

         <!-- Replace your single <button> with this logic -->
<div class="volunteer-actions" style="display: inline-block;">
    <% if (locals.user) { %>
        <% if (isVolunteering) { %>
            <!-- User is already signed up: Show 'Stop' button -->
            <form action="/project/unvolunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                <button type="submit" class="btn-small" style="background-color: #ef4444; border: none;">
                    Stop Volunteering
                </button>
            </form>
            <p style="color: #166534; font-size: 0.85rem; margin-top: 5px;">✓ You are on the list!</p>
        <% } else { %>
            <!-- User is logged in but not signed up: Show 'Join' button -->
            <form action="/project/volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                <button type="submit" class="btn-small" style="background-color: var(--accent); border: none;">
                    Sign Up to Volunteer
                </button>
            </form>
        <% } %>
    <% } else { %>
        <!-- User is not logged in -->
        <a href="/login" class="btn-small" style="text-decoration: none;">Login to Volunteer</a>
    <% } %>
</div>
        </section>
    </main>

    <%- include('partials/footer') %>