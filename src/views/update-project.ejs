<%- include('partials/header') %>
    <main class="container">
        <h1><%= title %></h1>

        <form action="/edit-project/<%= projectId %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" maxlength="150" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= projectDetails.location %>" maxlength="255" required />
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <% 
                let formattedDate = '';
                if (projectDetails.date) {
                    const d = new Date(projectDetails.date);
                    if (!isNaN(d.getTime())) {
                        formattedDate = d.toISOString().split('T')[0];
                    } else {
                        formattedDate = projectDetails.date;
                    }
                }
                %>
                <input type="date" id="date" name="date" value="<%= formattedDate %>" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>" <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions" style="margin-top: 20px;">
                <button type="submit" class="btn-small">Update Project</button>
                <a href="/project/<%= projectId %>" class="btn-small secondary" style="text-decoration: none; margin-left: 10px;">Cancel</a>
            </div>
        </form>
    </main>
<%- include('partials/footer') %>