<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (organizationDetails) { %>
            <h2>
                <%= organizationDetails.name %>
            </h2>
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

            <p>
                Description: <%= organizationDetails.description %>
            </p>
            <p>
                Contact: <%= organizationDetails.contact_email %>
            </p>

            <div class="card-actions">
                    <% if (user && user.role_name === 'admin') { %>
                    <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="view-details-btn">Edit Organization</a>
                    <a href="/new-organization" class="view-details-btn">Create New Organization</a>
                    <% } %>
                </div>

            <h3>Service Projects</h3>
            <ul>
                <% if (projects && projects.length> 0) { %>
                    <% projects.forEach(project=> { %>
                        <li>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </li>
                        <% }); %>
                            <% } else { %>
                                <li>No projects found for this organization.</li>
                                <% } %>
            </ul>

            <% } else { %>
                <p>Organization not found.</p>
                <% } %>
    </main>
   
    <%- include('partials/footer') %>