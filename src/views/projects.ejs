<%- include('partials/header') %>

    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <p>Showing the next 5 upcoming service opportunities:</p>

        <ul class="grid-list">
            <% projects.forEach(p=> { %>
<li class="project-card">
                    <!-- Requirement: Title is a link to the project details page -->
                    <h2>
                        <a href="/project/<%= p.project_id %>">
                            <%= p.title %>
                        </a>
                    </h2>

                    <!-- Requirement: Organization name is a link to the org details page -->
                    <p class="sponsored-by">
                        Sponsored by:
                        <a href="/organization/<%= p.organization_id %>">
                            <%= p.organization_name %>
                        </a>
                    </p>

                    <div class="card-actions">
                        <a href="/project/<%= p.project_id %>" class="btn-small-1">View Details</a>
                    </div>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name === 'admin') { %>
        <p class="btn-big"><a href="/new-project">Add a New Service Project</a></p>
        <% } %>
    </main>

    <%- include('partials/footer') %>